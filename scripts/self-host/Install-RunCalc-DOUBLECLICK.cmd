@echo off
setlocal EnableExtensions EnableDelayedExpansion
title Production Run Calculator - Windows Install
color 0A

:: ============================================================
:: SINGLE double-click installer (dummy-proof)
:: - Self-elevates to Administrator
:: - Writes the full PowerShell installer
:: - Installs prerequisites, Docker, app, config
:: - Schedules automatic resume after reboot if needed
:: ============================================================

set "ROOT=C:\runcalc"
set "WORKDIR=%ROOT%\installer"
set "PS1=%WORKDIR%\Install-RunCalcHost.ps1"
set "LOGDIR=%ROOT%\logs"
set "FLAG=%LOGDIR%\click-install-continue.flag"
set "SITE=Plant"
set "TZ=America/Chicago"
set "MANAGER=manager"

:: Optional: edit defaults above before distributing

mkdir "%WORKDIR%" 2>nul
mkdir "%LOGDIR%" 2>nul

:: --- Always re-launch elevated ---
net session >nul 2>&1
if not %errorlevel%==0 (
  echo Requesting Administrator permission...
  powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b
)

echo.
echo  ============================================
echo   RunCalc Windows auto-install
echo   Do not close this window until it finishes.
echo  ============================================
echo.

