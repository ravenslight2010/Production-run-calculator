> "%EXE_PS%" (
echo $b64 = Get-Content -LiteralPath '%B64%' -Raw
echo $bytes = [Convert]::FromBase64String(($b64 -replace '\s',''))
echo [IO.File]::WriteAllBytes('%PS1%', $bytes)
)
powershell -NoProfile -ExecutionPolicy Bypass -File "%EXE_PS%"
if errorlevel 1 (
  echo FAILED to extract installer payload.
  pause
  exit /b 1
)

:: Prefer PowerShell 7 if present
set "PWSH=%ProgramFiles%\PowerShell\7\pwsh.exe"
if not exist "%PWSH%" set "PWSH=powershell.exe"

set "EXTRA="
if exist "%FLAG%" (
  echo [2/3] Resuming after reboot...
  del "%FLAG%" 2>nul
  set "EXTRA=-ContinueAfterReboot"
) else (
  echo [2/3] Starting full install...
)

:: Mark that a reboot should re-run THIS .cmd (more reliable than only RunOnce inside ps1)
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce" /v RunCalcClickInstall /t REG_SZ /d "\"%~f0\"" /f >nul 2>&1
echo. > "%FLAG%"

echo [3/3] Running install engine...
echo Log folder: %LOGDIR%
echo.

"%PWSH%" -NoProfile -ExecutionPolicy Bypass -File "%PS1%" -NonInteractive -Site "%SITE%" -TimeZone "%TZ%" -Manager "%MANAGER%" %EXTRA%
set "ERR=%ERRORLEVEL%"

:: If install completed without scheduling another reboot, clear continue markers
if "%ERR%"=="0" (
  del "%FLAG%" 2>nul
  reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce" /v RunCalcClickInstall /f >nul 2>&1
  echo.
  echo  ============================================
  echo   FINISHED. Read C:\runcalc\RUNBOOK.txt
  echo  ============================================
) else (
  echo.
  echo  Install reported exit code %ERR%.
  echo  If the PC will reboot for WSL/Docker, just log in again ?
  echo  setup should continue automatically.
  echo  Otherwise open a new Admin window and run this file again.
  echo  Logs: %LOGDIR%
  echo  ============================================
)

echo.
pause
exit /b %ERR%
