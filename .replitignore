# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Python tooling is development-only; do not send the workspace's
# incomplete local environment to the deployment builder.
.pythonlibs

# Isolated browser evidence is not application source or publish input.
artifacts/run-calculator/generated-artifacts
docs/evidence/qc-slice-7-intelligence
artifacts/run-calculator/test-results
