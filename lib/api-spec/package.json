{
  "name": "@workspace/api-spec",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "orval --config ./orval.config.ts",
    "codegen": "pnpm run generate && pnpm -w run typecheck:libs",
    "check:toolchain": "node ./check-toolchain.mjs",
    "check:shell": "shellcheck ./check-generated.sh ./check-generated.test.sh ./check-typescript-7-bridge.sh",
    "check-generated": "pnpm run check:shell && bash ./check-generated.sh",
    "check:typescript-7-bridge": "bash ./check-typescript-7-bridge.sh",
    "test:generated-isolation": "bash ./check-generated.test.sh"
  },
  "devDependencies": {
    "orval": "8.39.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-coverage": "4.0.3",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "6.0.3"
  }
}
