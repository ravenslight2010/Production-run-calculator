{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./identity-sequence-health": {
      "types": "./migrations/identity-sequence-health.d.mts",
      "import": "./migrations/identity-sequence-health.mjs"
    },
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "pnpm run apply-serial-to-identity && drizzle-kit push --config ./drizzle.config.ts && pnpm run apply-audit-log-protection",
    "push-force": "pnpm run apply-serial-to-identity && drizzle-kit push --force --config ./drizzle.config.ts && pnpm run apply-audit-log-protection",
    "apply-audit-log-protection": "node ./migrations/apply-audit-log-protection.mjs",
    "apply-serial-to-identity": "node ./migrations/apply-serial-to-identity.mjs",
    "test:serial-to-identity": "node --test ./migrations/serial-to-identity.integration.test.mjs ./migrations/import-identity-write-guard.test.mjs",
    "check:identity-sequences": "node ./migrations/check-identity-sequence-drift.mjs"
  },
  "dependencies": {
    "@workspace/factory-constants": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
