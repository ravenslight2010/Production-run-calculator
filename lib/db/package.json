{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts && pnpm run apply-audit-log-protection",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts && pnpm run apply-audit-log-protection",
    "apply-audit-log-protection": "node ./migrations/apply-audit-log-protection.mjs"
  },
  "dependencies": {
    "@workspace/factory-constants": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
