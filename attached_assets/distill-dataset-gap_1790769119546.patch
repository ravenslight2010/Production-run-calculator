+/**
+ * Exact-content leakage gate (research doc section 5): the same
+ * contentSha256 must never appear in two live partitions, even for
+ * different brands (a re-skinned workbook is still a leak).
+ * Quarantine is exempt.
+ */
+export function assertNoCrossPartitionContentDuplicates(
+  entries: DistillManifestEntry[],
+): void {
+  const seen = new Map<string, DistillPartition>();
+  for (const e of entries) {
+    if (e.partition === "quarantine") continue;
+    const prev = seen.get(e.contentSha256);
+    if (prev && prev !== e.partition) {
+      throw new Error(
+        `content hash leak: ${e.contentSha256.slice(0, 12)}... in both ${prev} and ${e.partition}`,
+      );
+    }
+    seen.set(e.contentSha256, e.partition);
+  }
+}
