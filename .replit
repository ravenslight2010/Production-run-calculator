modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:client"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:rules"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:inventory-math"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:spec-reconcile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:scheduled-recipe-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:spec-export"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:corpus"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:client"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/run-calculator run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:rules"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/production-rules run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:inventory-math"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/inventory-math run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:spec-reconcile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/spec-reconcile run test"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test:scheduled-recipe-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scheduled-recipe-check run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:spec-export"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/spec-export run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm --filter @workspace/api-server run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Web App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/run-calculator && PORT=5173 BASE_PATH=/ pnpm run dev"
waitForPort = 5173

[[workflows.workflow]]
name = "test:corpus"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/corpus-harness run test"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["github:1.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 20191
externalPort = 3001

[[ports]]
localPort = 20192
externalPort = 3000

[[ports]]
localPort = 26038
externalPort = 3000
