modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:client"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:rules"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:inventory-math"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:spec-reconcile"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:client"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/run-calculator run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:rules"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/production-rules run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:inventory-math"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/inventory-math run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:spec-reconcile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/spec-reconcile run test"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 20191
externalPort = 3001

[[ports]]
localPort = 20192
externalPort = 5000

[[ports]]
localPort = 26038
externalPort = 3000

[nix]
channel = "stable-25_05"
