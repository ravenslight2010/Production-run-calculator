modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
build = ["bash", "scripts/src/run-release-node.sh", "pnpm", "--filter", "@workspace/lucia-v2", "run", "build"]
run = ["bash", "scripts/start-v2.sh"]
ignorePorts = false

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Local AI evaluator (private)"
mode = "sequential"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/local_model_eval_setup.py serve"

[[workflows.workflow]]
name = "test:rules"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/production-rules run test"

[[workflows.workflow]]
name = "test:inventory-math"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/inventory-math run test"

[[workflows.workflow]]
name = "test:spec-reconcile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/spec-reconcile run test"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test:scheduled-recipe-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/scheduled-recipe-check run test"

[[workflows.workflow]]
name = "test:spec-export"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/spec-export run test"

[[workflows.workflow]]
name = "test:corpus"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/corpus-harness run test"

[[workflows.workflow]]
name = "test:gemini"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh python3 scripts/test_gemini_skill_trigger_benchmark.py"

[[workflows.workflow]]
name = "check-model-bump"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/scripts run check-model-bump"

[[workflows.workflow]]
name = "operational-skill-evidence"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/scripts run check-operational-skill-evidence"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "security:prod"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm run audit:prod"

[[workflows.workflow]]
name = "evidence:release"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm --filter @workspace/scripts run check:release-evidence"

[[workflows.workflow]]
name = "release:standard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm run release:check"

[[workflows.workflow]]
name = "release:full"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/src/run-release-node.sh pnpm run release:check:full"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"
waitForPort = 5000

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-v2.sh"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["github:1.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 7200000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[userenv]

[userenv.shared]
V2_USE_PROJECT_DATABASE = "true"
