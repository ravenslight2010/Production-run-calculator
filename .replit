modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:client"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:rules"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:inventory-math"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:spec-reconcile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:scheduled-recipe-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:spec-export"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:corpus"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:gemini"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-model-bump"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "operational-skill-evidence"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "security:prod"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "evidence:release"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "release:standard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "release:full"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "browser-full-159"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:client"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/run-calculator run test"

[[workflows.workflow]]
name = "test:rules"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/production-rules run test"

[[workflows.workflow]]
name = "test:inventory-math"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/inventory-math run test"

[[workflows.workflow]]
name = "test:spec-reconcile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/spec-reconcile run test"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test:scheduled-recipe-check"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scheduled-recipe-check run test"

[[workflows.workflow]]
name = "test:spec-export"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/spec-export run test"

[[workflows.workflow]]
name = "test:corpus"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/corpus-harness run test"

[[workflows.workflow]]
name = "test:gemini"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/test_gemini_skill_trigger_benchmark.py"

[[workflows.workflow]]
name = "check-model-bump"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-model-bump"

[[workflows.workflow]]
name = "operational-skill-evidence"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-operational-skill-evidence"

[[workflows.workflow]]
name = "check:clean-start"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CLEAN_START_API_PORT=18081 CLEAN_START_WEB_PORT=18082 CLEAN_START_MOCKUP_PORT=18180 pnpm run check:clean-start"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "security:prod"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run audit:prod"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "evidence:release"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:release-evidence"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "release:standard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run release:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "release:full"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run release:check:full"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "browser-full-159"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "set -euo pipefail; PG_BIN=$(dirname \"$(command -v postgres)\"); PGDATA=$(mktemp -d /tmp/browser-validation-pg.XXXXXX); trap '\"$PG_BIN/pg_ctl\" -D \"$PGDATA\" -m immediate stop >/dev/null 2>&1 || true; rm -rf \"$PGDATA\"' EXIT; \"$PG_BIN/initdb\" -D \"$PGDATA\" -U postgres --auth=trust >/dev/null; \"$PG_BIN/pg_ctl\" -D \"$PGDATA\" -o '-F -p 15432 -k /tmp' -w start >/dev/null; \"$PG_BIN/createdb\" -h 127.0.0.1 -p 15432 -U postgres browser_e2e; export DATABASE_URL='postgresql://postgres@127.0.0.1:15432/browser_e2e' E2E_TEST_DB=1 E2E_APPROVED_DESTRUCTIVE_MODE=1 RELEASE_BROWSER_LOCAL_SERVERS=1 PLAYWRIGHT_BASE_URL='http://127.0.0.1:18084' PLAYWRIGHT_RELEASE_REPORT_PATH='/home/runner/workspace/release-evidence/browser-full/FINAL-REPORT.md'; pnpm --filter @workspace/db run push-force; cd artifacts/run-calculator; pnpm exec playwright test --config=playwright.config.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["github:1.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 20191
externalPort = 3001

[[ports]]
localPort = 20192
externalPort = 5000

[[ports]]
localPort = 26038
