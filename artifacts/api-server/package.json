{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && exec pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "pnpm exec tsc --build ../../lib/db ../../lib/api-zod ../../lib/integrations-openai-ai-server --force && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "benchmark:second-pass-reviewer-live": "../../scripts/node_modules/.bin/tsx scripts/benchmark-second-pass-reviewer-live.mts",
    "test:release:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:release:integration:1": "vitest run $(find src -name '*.integration.test.ts' ! -path 'src/routes/sync.integration.test.ts' ! -path 'src/routes/roles.integration.test.ts' | sort) --shard=1/3",
    "test:release:integration:2": "vitest run $(find src -name '*.integration.test.ts' ! -path 'src/routes/sync.integration.test.ts' ! -path 'src/routes/roles.integration.test.ts' | sort) --shard=2/3",
    "test:release:integration:3": "vitest run $(find src -name '*.integration.test.ts' ! -path 'src/routes/sync.integration.test.ts' ! -path 'src/routes/roles.integration.test.ts' | sort) --shard=3/3",
    "test:release:roles": "vitest run src/routes/roles.integration.test.ts",
    "test:release:sync": "vitest run src/routes/sync.integration.test.ts --testNamePattern='^(?!.*\\/sync\\/events)'",
    "test:release:sync-sse": "vitest run src/routes/sync.integration.test.ts --testNamePattern='\\/sync\\/events'",
    "test:release:concurrency": "timeout 180s sh -c 'pnpm exec vitest run src/routes/inventory.integration.test.ts --testNamePattern=\"concurrent|parallel|same run twice\" && pnpm exec vitest run src/routes/sync.integration.test.ts --testNamePattern=\"concurrent|burst under pool pressure|repeated first-write burst\"'"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@workspace/ai-memory": "workspace:*",
    "@workspace/ai-review": "workspace:*",
    "@workspace/anomaly": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/cycle-count": "workspace:*",
    "@workspace/day-summary": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/freezer-pull": "workspace:*",
    "@workspace/incident-cluster": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/inventory-math": "workspace:*",
    "@workspace/merge-suggest": "workspace:*",
    "@workspace/mix-reconcile": "workspace:*",
    "@workspace/mixes": "workspace:*",
    "@workspace/ingredient-catalog": "workspace:*",
    "@workspace/cheese-recipes": "workspace:*",
    "@workspace/named-recipes": "workspace:*",
    "@workspace/premix-import": "workspace:*",
    "@workspace/production-rules": "workspace:*",
    "@workspace/schedule-optimize": "workspace:*",
    "@workspace/spec-import": "workspace:*",
    "@workspace/spec-reconcile": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.1.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.9"
  }
}
