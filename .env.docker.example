# Copy this file to ".env" and fill in your own values, then run docker compose.
#   cp .env.docker.example .env

# ---- Database container (Postgres) ----
POSTGRES_DB=runcalc
POSTGRES_USER=runcalc_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- API server ----
NODE_ENV=production
PORT=5000
# NOTE: the host is "db" — the name of the database container above.
# Keep the user/password/db-name matching the three POSTGRES_ values.
DATABASE_URL=postgres://runcalc_user:CHANGE_ME_STRONG_PASSWORD@db:5432/runcalc

# Shared code staff must enter to create an account (pick something hard to guess).
STAFF_SIGNUP_CODE=your-facility-signup-code

# These two bootstrap your FIRST manager account: sign up with this exact username
# AND enter this access code, and that account becomes the manager.
INITIAL_MANAGER_USERNAME=yourmanagername
INITIAL_MANAGER_ACCESS_CODE=your-manager-bootstrap-code

# For the AI features (issue diagnosis, forecasts, etc.).
# Either a Gemini credential (Replit proxy or direct GOOGLE_API_KEY) OR a
# self-hosted local model server (see the LOCAL_AI_* block below) must be set.
OPENAI_API_KEY=sk-...

# ---- Self-hosted local AI (optional) ----
# Set LOCAL_AI_BASE_URL to route AI calls to an OpenAI-compatible server
# (Ollama / llama.cpp) instead of Gemini. Easiest path: use the bundled overlay,
#   docker compose -f docker-compose.yml -f docker-compose.local-ai.yml up -d
# which starts Ollama and sets these automatically. Set them here only if you
# run the model server yourself.
# LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_AI_API_KEY=ollama
# LOCAL_MODEL_FULL=qwen3:14b
# LOCAL_MODEL_CHEAP=qwen3:4b
# Retry Gemini only on transport-level local failures (connection/DNS/timeout/5xx):
# LOCAL_AI_FALLBACK_TO_GEMINI=false
# Fail readiness when the local model host is unreachable:
# LOCAL_AI_STRICT_READINESS=false

# ---- Web server (Caddy) ----
# Real domain with automatic HTTPS:  SITE_ADDRESS=runcalc.yourcompany.com
# Local testing over plain HTTP:      SITE_ADDRESS=:80
SITE_ADDRESS=:80

# Your public domain, used by the API for CORS. Leave blank when using the
# bundled web+API on one domain (they are same-origin). Set it if you ever
# serve the web app from a different domain than the API.
REPLIT_DOMAINS=
